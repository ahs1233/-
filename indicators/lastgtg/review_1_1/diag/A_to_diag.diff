+// ==== GATE 4 DIAGNOSTIC EXPORTS (export only; added by review_1_1/diag/build-diag.mjs) ====
+// Nothing below is read by the indicator. New names only; plots go to the Data Window.
+int dgEvents = (breakResistance ? 1 : 0) + (breakSupport ? 2 : 0) + (breakAcceptedUp ? 4 : 0) + (breakAcceptedDn ? 8 : 0) + (rejectResistance ? 16 : 0) + (rejectSupport ? 32 : 0) + (flipConfirmedEvent ? 64 : 0) + (engineOn ? 128 : 0)
+int dgLampA = 1
+int dgCodeA = 0
+if heldAccUp or heldAccDn
+    dgCodeA := heldAccUp ? 1 : 2
+    dgLampA := 2
+else if noChase
+    dgCodeA := 3
+    dgLampA := 0
+else if priceInsideObstacle
+    dgCodeA := obstacleRole == 1 ? 4 : obstacleRole == -1 ? 5 : 6
+    dgLampA := 0
+else if routeSign != 0 and headingSign != 0 and routeSign != headingSign
+    dgCodeA := 7
+    dgLampA := 0
+else if heldBrkR or heldBrkS
+    dgCodeA := 8
+else if heldRejR or heldRejS
+    dgCodeA := heldRejR ? 9 : 10
+else if obstacleNear or candleTouchesObstacle
+    dgCodeA := obstacleRole == 1 ? 11 : obstacleRole == -1 ? 12 : 13
+else if movingTowardResistance or movingTowardSupport
+    dgCodeA := movingTowardResistance ? 14 : 15
+else if fuelExhaustion
+    dgCodeA := 16
+else if headingSign == 0
+    dgCodeA := 17
+else if routeSign == 0
+    dgCodeA := 18
+else if fuelScore < fuelLowThreshold
+    dgCodeA := 19
+else if headingSign == routeSign and obstacleAvailable and nearestObstacleAtr * atrEng < greenRoomHtfAtr * safeHtfAtr
+    dgCodeA := obstacleRole == 1 ? 20 : 21
+else if headingSign == routeSign
+    dgCodeA := 22
+    dgLampA := 2
+// Episode rule of the contract on A's lamp (the B/C gtgGreenStart rule; lamp 1 while the engine is off).
+var int dgLampClosedA = 1
+var int dgHeadingClosedA = 0
+if barstate.isconfirmed
+    dgLampClosedA := engineOn ? dgLampA : 1
+    dgHeadingClosedA := headingSign
+bool dgStartA = engineStep and dgLampClosedA == 2 and (nz(dgLampClosedA[1], 1) != 2 or dgHeadingClosedA != nz(dgHeadingClosedA[1], 0))
+plot(open, "m_open", display = display.data_window)
+plot(high, "m_high", display = display.data_window)
+plot(low, "m_low", display = display.data_window)
+plot(close, "m_close", display = display.data_window)
+plot(volume, "m_volume", display = display.data_window)
+plot(headingScore, "m_headingScore", display = display.data_window)
+plot(routeScore, "m_routeScore", display = display.data_window)
+plot(speedScore, "m_speedScore", display = display.data_window)
+plot(instantSpeedScore, "m_instantSpeedScore", display = display.data_window)
+plot(fuelScore, "m_fuelScore", display = display.data_window)
+plot(fuelAcceleration, "m_fuelAcceleration", display = display.data_window)
+plot(atrEng, "m_atrEng", display = display.data_window)
+plot(htfClose, "m_htfClose", display = display.data_window)
+plot(htfMA50, "m_htfMA50", display = display.data_window)
+plot(htfMA200, "m_htfMA200", display = display.data_window)
+plot(htfATR, "m_htfATR", display = display.data_window)
+plot(obstacleRole, "m_obstacleRole", display = display.data_window)
+plot(nearestObstacleAtr, "m_nearestObstacleAtr", display = display.data_window)
+plot(slotR1.active ? slotR1.lo : na, "m_R1_lo", display = display.data_window)
+plot(slotR1.active ? slotR1.hi : na, "m_R1_hi", display = display.data_window)
+plot(slotR1.active ? slotR1.quality : na, "m_R1_q", display = display.data_window)
+plot(slotR2.active ? slotR2.lo : na, "m_R2_lo", display = display.data_window)
+plot(slotR2.active ? slotR2.hi : na, "m_R2_hi", display = display.data_window)
+plot(slotR2.active ? slotR2.quality : na, "m_R2_q", display = display.data_window)
+plot(slotS1.active ? slotS1.lo : na, "m_S1_lo", display = display.data_window)
+plot(slotS1.active ? slotS1.hi : na, "m_S1_hi", display = display.data_window)
+plot(slotS1.active ? slotS1.quality : na, "m_S1_q", display = display.data_window)
+plot(slotS2.active ? slotS2.lo : na, "m_S2_lo", display = display.data_window)
+plot(slotS2.active ? slotS2.hi : na, "m_S2_hi", display = display.data_window)
+plot(slotS2.active ? slotS2.quality : na, "m_S2_q", display = display.data_window)
+plot((slotR1.active ? (slotR1.containing ? 2 : 1) : 0) + 3 * (slotR2.active ? (slotR2.containing ? 2 : 1) : 0) + 9 * (slotS1.active ? (slotS1.containing ? 2 : 1) : 0) + 27 * (slotS2.active ? (slotS2.containing ? 2 : 1) : 0), "m_slotCodes", display = display.data_window)
+plot(dgEvents, "m_events", display = display.data_window)
+plot(engineOn ? dgLampClosedA : na, "m_lampA", display = display.data_window)
+plot(engineOn ? dgCodeA : na, "m_codeA", display = display.data_window)
+plot(dgStartA ? 1 : 0, "m_startA", display = display.data_window)
