+        35 => "رفض من الجهتين"
+        36 => "رفض من مقاومة"
+        37 => "ارتداد من دعم"
+        40 => role == 1 ? "مقاومة قريبة" : role == -1 ? "دعم قريب" : "منطقة قريبة"
+        41 => role == 1 ? "مقاومة أمامه" : role == -1 ? "دعم أمامه" : "عائق أمامه"
+        42 => "الزخم يضعف"
+        43 => "الوقود ضعيف"
+        44 => "لم أجد منطقة أمامه"
+        45 => "المساحة المقاسة غير كافية"
